<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd"
	 defaultPackage="ch.so.agi.datahub.cayenne">
	<dbEntity name="core_apikey" schema="agi_datahub_config_v1">
		<dbAttribute name="apikey" type="VARCHAR" mandatory="true" length="256"/>
		<dbAttribute name="createdat" type="TIMESTAMP" mandatory="true" length="29"/>
		<dbAttribute name="dateofexpiry" type="TIMESTAMP" length="29"/>
		<dbAttribute name="organisation_r" type="BIGINT" mandatory="true" length="19"/>
		<dbAttribute name="revokedat" type="TIMESTAMP" length="29"/>
		<dbAttribute name="t_id" type="BIGINT" primaryKey="true" generated="true" mandatory="true" length="19"/>
	</dbEntity>
	<dbEntity name="core_operat" schema="agi_datahub_config_v1">
		<dbAttribute name="adescription" type="VARCHAR" length="1024"/>
		<dbAttribute name="aname" type="VARCHAR" mandatory="true" length="512"/>
		<dbAttribute name="organisation_r" type="BIGINT" mandatory="true" length="19"/>
		<dbAttribute name="t_id" type="BIGINT" primaryKey="true" generated="true" mandatory="true" length="19"/>
		<dbAttribute name="theme_r" type="BIGINT" mandatory="true" length="19"/>
	</dbEntity>
	<dbEntity name="core_organisation" schema="agi_datahub_config_v1">
		<dbAttribute name="aname" type="VARCHAR" mandatory="true" length="512"/>
		<dbAttribute name="arole" type="VARCHAR" mandatory="true" length="20"/>
		<dbAttribute name="auid" type="VARCHAR" length="15"/>
		<dbAttribute name="email" type="VARCHAR" mandatory="true" length="512"/>
		<dbAttribute name="t_id" type="BIGINT" primaryKey="true" generated="true" mandatory="true" length="19"/>
	</dbEntity>
	<dbEntity name="core_theme" schema="agi_datahub_config_v1">
		<dbAttribute name="adescription" type="VARCHAR" length="1024"/>
		<dbAttribute name="aname" type="VARCHAR" mandatory="true" length="512"/>
		<dbAttribute name="config" type="VARCHAR" length="512"/>
		<dbAttribute name="expected_models" type="VARCHAR" length="2048"/>
		<dbAttribute name="metaconfig" type="VARCHAR" length="512"/>
		<dbAttribute name="t_id" type="BIGINT" primaryKey="true" generated="true" mandatory="true" length="19"/>
	</dbEntity>
	<dbEntity name="deliveries_delivery" schema="agi_datahub_log_v1">
		<dbAttribute name="artifacts_expired" type="BIT" length="1"/>
		<dbAttribute name="deliverydate" type="TIMESTAMP" mandatory="true" length="29"/>
		<dbAttribute name="email" type="VARCHAR" length="512"/>
		<dbAttribute name="expected_models" type="VARCHAR" length="2048"/>
		<dbAttribute name="finished_at" type="TIMESTAMP" length="29"/>
		<dbAttribute name="isdelivered" type="BIT" length="1"/>
		<dbAttribute name="isvalid" type="BIT" length="1"/>
		<dbAttribute name="jobid" type="VARCHAR" mandatory="true" length="36"/>
		<dbAttribute name="legacy_log" type="VARCHAR" length="100"/>
		<dbAttribute name="notification_status" type="VARCHAR" length="20"/>
		<dbAttribute name="operat" type="VARCHAR" mandatory="true" length="512"/>
		<dbAttribute name="organisation" type="VARCHAR" mandatory="true" length="512"/>
		<dbAttribute name="processing_status" type="VARCHAR" length="20"/>
		<dbAttribute name="result_models" type="VARCHAR"/>
		<dbAttribute name="t_id" type="BIGINT" primaryKey="true" generated="true" mandatory="true" length="19"/>
		<dbAttribute name="theme" type="VARCHAR" mandatory="true" length="512"/>
		<dbAttribute name="transfer_version" type="VARCHAR" length="10"/>
		<dbAttribute name="updated_at" type="TIMESTAMP" length="29"/>
		<dbAttribute name="validator_config" type="VARCHAR" length="512"/>
		<dbAttribute name="validator_meta_config" type="VARCHAR" length="512"/>
		<dbAttribute name="validator_version" type="VARCHAR" length="128"/>
	</dbEntity>
	<objEntity name="CoreApikey" className="ch.so.agi.datahub.cayenne.CoreApikey" dbEntityName="core_apikey">
		<objAttribute name="apikey" type="java.lang.String" dbAttributePath="apikey"/>
		<objAttribute name="createdat" type="java.time.LocalDateTime" dbAttributePath="createdat"/>
		<objAttribute name="dateofexpiry" type="java.time.LocalDateTime" dbAttributePath="dateofexpiry"/>
		<objAttribute name="revokedat" type="java.time.LocalDateTime" dbAttributePath="revokedat"/>
	</objEntity>
	<objEntity name="CoreOperat" className="ch.so.agi.datahub.cayenne.CoreOperat" dbEntityName="core_operat">
		<objAttribute name="adescription" type="java.lang.String" dbAttributePath="adescription"/>
		<objAttribute name="aname" type="java.lang.String" dbAttributePath="aname"/>
	</objEntity>
	<objEntity name="CoreOrganisation" className="ch.so.agi.datahub.cayenne.CoreOrganisation" dbEntityName="core_organisation">
		<objAttribute name="aname" type="java.lang.String" dbAttributePath="aname"/>
		<objAttribute name="arole" type="java.lang.String" dbAttributePath="arole"/>
		<objAttribute name="auid" type="java.lang.String" dbAttributePath="auid"/>
		<objAttribute name="email" type="java.lang.String" dbAttributePath="email"/>
	</objEntity>
	<objEntity name="CoreTheme" className="ch.so.agi.datahub.cayenne.CoreTheme" dbEntityName="core_theme">
		<objAttribute name="adescription" type="java.lang.String" dbAttributePath="adescription"/>
		<objAttribute name="aname" type="java.lang.String" dbAttributePath="aname"/>
		<objAttribute name="config" type="java.lang.String" dbAttributePath="config"/>
		<objAttribute name="expectedModels" type="java.lang.String" dbAttributePath="expected_models"/>
		<objAttribute name="metaconfig" type="java.lang.String" dbAttributePath="metaconfig"/>
	</objEntity>
	<objEntity name="DeliveriesDelivery" className="ch.so.agi.datahub.cayenne.DeliveriesDelivery" dbEntityName="deliveries_delivery">
		<objAttribute name="artifactsExpired" type="java.lang.Boolean" dbAttributePath="artifacts_expired"/>
		<objAttribute name="deliverydate" type="java.time.LocalDateTime" dbAttributePath="deliverydate"/>
		<objAttribute name="email" type="java.lang.String" dbAttributePath="email"/>
		<objAttribute name="expectedModels" type="java.lang.String" dbAttributePath="expected_models"/>
		<objAttribute name="finishedAt" type="java.time.LocalDateTime" dbAttributePath="finished_at"/>
		<objAttribute name="isdelivered" type="java.lang.Boolean" dbAttributePath="isdelivered"/>
		<objAttribute name="isvalid" type="java.lang.Boolean" dbAttributePath="isvalid"/>
		<objAttribute name="jobid" type="java.lang.String" dbAttributePath="jobid"/>
		<objAttribute name="legacyLog" type="java.lang.String" dbAttributePath="legacy_log"/>
		<objAttribute name="notificationStatus" type="java.lang.String" dbAttributePath="notification_status"/>
		<objAttribute name="operat" type="java.lang.String" dbAttributePath="operat"/>
		<objAttribute name="organisation" type="java.lang.String" dbAttributePath="organisation"/>
		<objAttribute name="processingStatus" type="java.lang.String" dbAttributePath="processing_status"/>
		<objAttribute name="resultModels" type="java.lang.String" dbAttributePath="result_models"/>
		<objAttribute name="theme" type="java.lang.String" dbAttributePath="theme"/>
		<objAttribute name="transferVersion" type="java.lang.String" dbAttributePath="transfer_version"/>
		<objAttribute name="updatedAt" type="java.time.LocalDateTime" dbAttributePath="updated_at"/>
		<objAttribute name="validatorConfig" type="java.lang.String" dbAttributePath="validator_config"/>
		<objAttribute name="validatorMetaConfig" type="java.lang.String" dbAttributePath="validator_meta_config"/>
		<objAttribute name="validatorVersion" type="java.lang.String" dbAttributePath="validator_version"/>
	</objEntity>
	<dbRelationship name="organisationR" source="core_apikey" target="core_organisation">
		<dbAttributePair source="organisation_r" target="t_id"/>
	</dbRelationship>
	<dbRelationship name="organisationR" source="core_operat" target="core_organisation">
		<dbAttributePair source="organisation_r" target="t_id"/>
	</dbRelationship>
	<dbRelationship name="themeR" source="core_operat" target="core_theme">
		<dbAttributePair source="theme_r" target="t_id"/>
	</dbRelationship>
	<dbRelationship name="apikeys" source="core_organisation" target="core_apikey" toMany="true">
		<dbAttributePair source="t_id" target="organisation_r"/>
	</dbRelationship>
	<dbRelationship name="operats" source="core_organisation" target="core_operat" toMany="true">
		<dbAttributePair source="t_id" target="organisation_r"/>
	</dbRelationship>
	<dbRelationship name="operats" source="core_theme" target="core_operat" toMany="true">
		<dbAttributePair source="t_id" target="theme_r"/>
	</dbRelationship>
	<objRelationship name="organisationR" source="CoreApikey" target="CoreOrganisation" deleteRule="nullify" dbRelationshipPath="organisationR"/>
	<objRelationship name="organisationR" source="CoreOperat" target="CoreOrganisation" deleteRule="nullify" dbRelationshipPath="organisationR"/>
	<objRelationship name="themeR" source="CoreOperat" target="CoreTheme" deleteRule="nullify" dbRelationshipPath="themeR"/>
	<objRelationship name="apikeys" source="CoreOrganisation" target="CoreApikey" deleteRule="deny" dbRelationshipPath="apikeys"/>
	<objRelationship name="operats" source="CoreOrganisation" target="CoreOperat" deleteRule="deny" dbRelationshipPath="operats"/>
	<objRelationship name="operats" source="CoreTheme" target="CoreOperat" deleteRule="deny" dbRelationshipPath="operats"/>
</dataMap>
