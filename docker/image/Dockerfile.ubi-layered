FROM eclipse-temurin:21.0.5_11-jre-ubi9-minimal AS builder
WORKDIR /builder
COPY tmp/datahub-*-exec.jar application.jar
RUN java -Djarmode=tools -jar application.jar extract --layers --destination extracted

FROM eclipse-temurin:21.0.5_11-jre-ubi9-minimal
RUN microdnf update -y && microdnf reinstall tzdata -y
ARG UID=1001
RUN adduser -u $UID datahub
ENV HOME=/datahub TZ=Europe/Zurich SPRING_PROFILES_ACTIVE=prod
WORKDIR /work
RUN chown $UID:0 . && chmod 0775 .
VOLUME ["/work"]
WORKDIR /datahub
RUN chown $UID:0 . && chmod 0775 .
VOLUME ["/datahub"]
WORKDIR /application
COPY --chown=$UID:0 --from=builder /builder/extracted/dependencies/ ./
COPY --chown=$UID:0 --from=builder /builder/extracted/spring-boot-loader/ ./
COPY --chown=$UID:0 --from=builder /builder/extracted/snapshot-dependencies/ ./
COPY --chown=$UID:0 --from=builder /builder/extracted/application/ ./
USER $UID
EXPOSE 8080
ENTRYPOINT ["java", "-XX:+UseParallelGC", "-XX:MaxRAMPercentage=90.0", "-jar", "application.jar"]
